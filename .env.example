# Copy this file to .env and fill in your Supabase project's values
# (Supabase Dashboard → Project Settings → API Keys). See AUTH_SETUP.md.

# Public — safe to ship in client-side code. Access is controlled by the Row
# Level Security policies in supabase/schema.sql, not by hiding these.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_JWKS_URL=https://xxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Secret — server-only. Do NOT prefix this with NEXT_PUBLIC_, or it will be
# bundled into client-side JS and exposed to every visitor.
SUPABASE_SECRET_KEY=your-secret-key
